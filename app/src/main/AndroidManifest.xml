<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads how long each app was open today. A special-access grant routed
         through Settings, not a runtime dialog. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- The launcher-intent query answers what a home screen can show; this
         declaration is the documented fallback for a launcher and needs a
         written justification at submission time. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- There is deliberately no INTERNET permission. Nothing this app reads
         can leave the device, and that is enforced by the manifest rather than
         promised by the copy. -->

    <application
        android:name=".DumbifyApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dumbify">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Dumbify"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registers Dumbify as a home-screen replacement. This is the whole
             of the enforcement model: while a window is in force the Home
             action lands on the typeset list, and a disallowed app is absent
             from it (design decision 1).

             It is an alias rather than a second filter on the activity because
             a component can be switched off and an intent filter cannot.
             Android has no API to hand back ROLE_HOME, so "stop enforcing"
             disables this alias, which takes Dumbify out of the home-app
             candidates entirely (design decision 4).

             Keeping it off MainActivity also stops an icon launch being
             classified as a home task, which is what suppressed the
             app-to-home transition. -->
        <activity-alias
            android:name=".HomeSurface"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".widget.DumbifyWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dumbify_widget_info" />
        </receiver>
    </application>

</manifest>